{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 140 },
    "db": { "x": 40, "y": 224 },
    "entities": { "x": 370, "y": 224 },
    "spaces": { "x": 700, "y": 224 },
    "placed": { "x": 1030, "y": 224 },
    "perStorey": { "x": 1360, "y": 224 },
    "sorted": { "x": 1690, "y": 224 },
    "answer": { "x": 2020, "y": 224 },
    "storeys": { "x": 370, "y": 464 }
  },
  "structure": {
    "inputs": [
      { "default": "{PUBLIC}/schependomlaan.duckdb", "description": "The building's BIM Open Schema DuckDB file; any public sample building works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "db.source", "to": "entities.path" },
      { "from": "db.source", "to": "storeys.path" },
      { "from": "entities.table", "to": "spaces.table" },
      { "from": "spaces.table", "to": "placed.a" },
      { "from": "storeys.table", "to": "placed.b" },
      { "from": "placed.table", "to": "perStorey.table" },
      { "from": "perStorey.table", "to": "sorted.table" },
      { "from": "sorted.table", "to": "answer.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "answer", "kind": "chart.bar", "version": 1 },
      { "id": "db", "kind": "duck.source", "version": 1 },
      { "id": "entities", "kind": "duck.table", "version": 1 },
      { "id": "perStorey", "kind": "table.aggregate", "version": 1 },
      { "id": "placed", "kind": "table.join", "version": 1 },
      { "id": "sorted", "kind": "table.sort", "version": 1 },
      { "id": "spaces", "kind": "table.filter", "version": 1 },
      { "id": "storeys", "kind": "duck.table", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "How many spaces each storey of Schependomlaan has. One duck.source, db, opens the file the model input names, and both readers share it; set model to another building's .duckdb (digitalhub-arc.duckdb gives 12, 26, and 26 spaces) and every reader follows. Every space is placed on its storey directly (Depth 1 in StoreyOfElement), so each counts once." },
    "answer": { "labelColumn": "StoreyName", "title": "Spaces per storey", "valueColumns": "Spaces" },
    "db": { "path": "$model" },
    "entities": { "table": "EntityText" },
    "perStorey": { "aggregates": "count(EntityIndex) as Spaces", "groupBy": "StoreyName" },
    "placed": { "aKey": "EntityIndex", "mode": "inner" },
    "sorted": { "A": "StoreyName" },
    "spaces": { "expr": "Category == 'IFCSPACE'" },
    "storeys": { "table": "StoreyOfElement" }
  }
}
