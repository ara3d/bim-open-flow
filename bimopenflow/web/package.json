{
  "name": "bimopenflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "host": "dotnet run --project ../../src/flow/BimOpenFlow.Host -- --port 5214 --store ../../artifacts/flow/store --cache ../../artifacts/flow/cache",
    "web": "npm run dev -w @bimopenflow/app",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @bimopenflow/app"
  }
}
