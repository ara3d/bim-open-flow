    "PortType": ["Boolean", "Integer", "Number", "Text", "Table", "Any"],
    "ColumnType": ["Boolean", "Integer", "Number", "Text"],
    "NodeCapability": ["Pure", "Effect"],
    "Verdict": ["Pass", "Fail", "NeedsReview", "InfoNotAvailable"]
