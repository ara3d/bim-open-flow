{
  "version": "0.1.0",
  "description": "Single source of truth for app-level shared types. Edit this file, run `node contracts/generate.mjs`, commit the generated outputs. Never hand-edit generated files.",
  "enums": {
    "ParamKind": ["Boolean", "Integer", "Number", "Text", "Enum", "FilePath", "ModelRef", "Expression", "Json", "DateTime"],
    "PortType": ["Boolean", "Integer", "Number", "Text", "Table", "Any"],
    "ColumnType": ["Boolean", "Integer", "Number", "Text"],
    "NodeCapability": ["Pure", "Effect"],
    "Verdict": ["Pass", "Fail", "NeedsReview", "InfoNotAvailable"],
    "ModelKind": ["Ifc", "Bos"],
    "NodeStatus": ["Ok", "Unready", "EffectPending", "Unavailable", "Error"],
    "SuggestKind": ["ColumnsOfInput", "TablesInFile"],
    "SuggestStatus": ["Ok", "Unready", "Unavailable"]
  },
  "types": {
    "ColumnSchema": {
      "name": "string",
      "type": "ColumnType"
    },
    "TableData": {
      "columns": "ColumnSchema[]",
      "rows": "any[][]"
    },
    "PortDescriptor": {
      "name": "string",
      "type": "PortType",
      "optional": "bool"
    },
    "ParamDescriptor": {
      "name": "string",
      "kind": "ParamKind",
      "default": "string",
      "enumValues": "string[]?",
      "suggest": "SuggestDescriptor?"
    },
    "SuggestDescriptor": {
      "kind": "SuggestKind",
      "source": "string"
    },
    "Suggestion": {
      "value": "string",
      "detail": "string?"
    },
    "SuggestionList": {
      "status": "SuggestStatus",
      "values": "Suggestion[]",
      "reason": "string?"
    },
    "NodeDescriptor": {
      "kind": "string",
      "version": "int",
      "capability": "NodeCapability",
      "inputs": "PortDescriptor[]",
      "outputs": "PortDescriptor[]",
      "params": "ParamDescriptor[]",
      "description": "string"
    },
    "NodeCatalog": {
      "nodes": "NodeDescriptor[]"
    },
    "ModelSummary": {
      "id": "string",
      "name": "string",
      "kind": "ModelKind",
      "sizeBytes": "long",
      "lastWriteUtc": "string",
      "sourcePath": "string"
    },
    "AnalysisSummary": {
      "id": "string",
      "graphHash": "string"
    },
    "AnalysisVersion": {
      "version": "int",
      "graphHash": "string"
    },
    "NodeState": {
      "nodeId": "string",
      "status": "NodeStatus",
      "error": "string?",
      "warnings": "string[]"
    },
    "EvalUpdate": {
      "analysisId": "string",
      "nodes": "NodeState[]"
    },
    "TableSlice": {
      "columns": "ColumnSchema[]",
      "rows": "any[][]",
      "totalRows": "int",
      "skip": "int"
    },
    "RunSummary": {
      "fileName": "string",
      "timestampUtc": "string",
      "graphHash": "string"
    },
    "SelectionEvent": {
      "source": "string",
      "ids": "string[]"
    },
    "ApiError": {
      "error": "string"
    }
  },
  "endpoints": [
    { "name": "listModels", "method": "GET", "path": "/api/models", "response": "ModelSummary[]" },
    { "name": "getModelBos", "method": "GET", "path": "/api/models/{id}/bos", "response": "bytes" },
    { "name": "listAnalyses", "method": "GET", "path": "/api/analyses", "response": "AnalysisSummary[]" },
    { "name": "getAnalysis", "method": "GET", "path": "/api/analyses/{id}", "response": "text" },
    { "name": "putAnalysis", "method": "PUT", "path": "/api/analyses/{id}", "body": "text", "response": "AnalysisSummary" },
    { "name": "getAnalysisHistory", "method": "GET", "path": "/api/analyses/{id}/history", "response": "AnalysisVersion[]" },
    { "name": "getNodeCatalog", "method": "GET", "path": "/api/catalog/nodes", "response": "NodeCatalog" },
    { "name": "getAnalysisState", "method": "GET", "path": "/api/analyses/{id}/state", "response": "EvalUpdate" },
    { "name": "getResult", "method": "GET", "path": "/api/analyses/{id}/results/{nodeId}/{port}", "query": { "skip": "int?", "take": "int?" }, "response": "TableSlice" },
    { "name": "getSuggestions", "method": "GET", "path": "/api/analyses/{id}/suggestions/{nodeId}/{param}", "response": "SuggestionList" },
    { "name": "listRuns", "method": "GET", "path": "/api/analyses/{id}/runs", "response": "RunSummary[]" },
    { "name": "createRun", "method": "POST", "path": "/api/analyses/{id}/runs", "response": "RunSummary" },
    { "name": "getRun", "method": "GET", "path": "/api/analyses/{id}/runs/{fileName}", "response": "text" },
    { "name": "analysisEvents", "method": "GET", "path": "/api/analyses/{id}/events", "sse": "EvalUpdate" }
  ]
}
