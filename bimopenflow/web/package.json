{
  "name": "bimopenflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "host": "dotnet run --project ../../src/flow/BimOpenFlow.Host -- --profile bim --port 5214 --store ../../artifacts/bim-flow/store --cache ../../artifacts/bim-flow/cache",
    "web": "npm run dev -w @bimopenflow/app",
    "duckdb:prepare": "node ../../scripts/prepare-bim-flow-duckdb.mjs",
    "duckdb:build": "dotnet build ../../src/studio/BimOpenFlow.Studio -o ../../artifacts/bim-flow-duckdb/studio --verbosity quiet",
    "duckdb:host": "dotnet ../../artifacts/bim-flow-duckdb/studio/bimopenflow-studio.dll --profile tables --port 5218 --store ../../artifacts/bim-flow-duckdb/store --cache ../../artifacts/bim-flow-duckdb/cache --models ../../artifacts/building-model-workflows",
    "duckdb:web": "npm run duckdb -w @bimopenflow/app",
    "mcp:build": "node ../../scripts/build-mcp.mjs",
    "mcp:check": "node ../../scripts/build-mcp.mjs --check",
    "duckdb:mcp-build": "dotnet build ../../src/mcp/BimOpenMcp.Flow -o ../../artifacts/bim-flow-duckdb/mcp --verbosity quiet",
    "duckdb:mcp-demo": "node ../../scripts/demo-bim-flow-mcp.mjs",
    "ifc:mcp-build": "dotnet build ../../src/mcp/BimOpenMcp.Ifc -o ../../artifacts/bim-flow-ifc/mcp --verbosity quiet",
    "ifc:mcp-demo": "node ../../scripts/demo-ifc-mcp.mjs",
    "ifc:ask-build": "dotnet build ../../src/studio/BimOpenMcp.Ifc.Ask -o ../../artifacts/bim-flow-ifc/ask --verbosity quiet",
    "nrc:walkthrough": "node ../../scripts/nrc-walkthrough.mjs"
  }
}
